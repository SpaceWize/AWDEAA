# Copy this file to .env and fill in real values. .env is gitignored; this
# file is the template that stays in version control.
#
# VITE_GCAL_ID  — the calendar's ID from Settings and sharing > Integrate
#                 calendar. Looks like an email address, not the display name.
# VITE_GCAL_KEY — an API key from Google Cloud Console with the Calendar API
#                 enabled, restricted to this site's domain under
#                 Application restrictions > HTTP referrers.
VITE_GCAL_ID=
VITE_GCAL_KEY=
